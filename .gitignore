# =============================================================
# AI-SOC Demo — .gitignore
# =============================================================

# Secrets — NEVER commit
.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environment
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Database (currently INCLUDED in the repo — un-comment to exclude again)
# data/soc.db

# Generated model artifacts (currently INCLUDED — un-comment to exclude again)
# models/*.joblib
# models/registry.json

# Generated synthetic data (currently INCLUDED — un-comment to exclude again)
# data/synthetic/
# data/processed/
# data/raw/

# Generated results (currently INCLUDED — un-comment to exclude again)
# results/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Windows
*.lnk

# Logs
*.log

# Temp scripts created during development
scripts/_*.py
