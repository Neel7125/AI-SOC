# =============================================================
# AI-SOC Demo — environment configuration
# Copy to .env and fill in secrets. NEVER commit .env.
# All settings have safe defaults so the demo works out-of-the-box
# in offline mode without any keys.
# =============================================================

# ---- Database -----------------------------------------------
# Default: data/soc.db (relative to project root)
# SOC_DB_PATH=data/soc.db

# ---- LLM provider -------------------------------------------
# Options: offline | openai | ollama
# "offline" is a deterministic template summariser - works without credentials.
LLM_PROVIDER=offline

# OpenAI (required when LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # override for Azure / proxy

# Ollama (required when LLM_PROVIDER=ollama)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# ---- RAG / Embeddings ----------------------------------------
# Options: tfidf | sbert
# "tfidf" works offline; "sbert" requires sentence-transformers
EMBEDDING_BACKEND=tfidf
# SBERT_MODEL=all-MiniLM-L6-v2
# RAG_TOP_K=4
# RAG_MIN_SCORE=0.05

# ---- ML thresholds ------------------------------------------
# ALERT_RISK_THRESHOLD=35
# ML_THRESHOLD=0.5

# ---- Active dataset -----------------------------------------
# Which dataset to train on. "synthetic" always works; others need the
# CSV downloaded and the path set below.
ACTIVE_DATASET=synthetic

# Real dataset paths (leave blank / absent to use synthetic data only)
# CICIDS2017_PATH=data/raw/CIC-IDS2017.csv
# CICIDS2018_PATH=data/raw/CSE-CIC-IDS2018.csv
# UNSWNB15_PATH=data/raw/UNSW-NB15.csv
# BETH_PATH=data/raw/beth.csv

# ---- Splunk / SIEM (optional) --------------------------------
# SPLUNK_HOST=splunk.example.com
# SPLUNK_PORT=8089
# SPLUNK_TOKEN=your-splunk-token
# SPLUNK_USER=admin
# SPLUNK_PASSWORD=changeme
# SPLUNK_VERIFY_TLS=false

# ---- Logging ------------------------------------------------
# LOG_LEVEL=INFO
